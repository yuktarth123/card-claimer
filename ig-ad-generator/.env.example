# Copy this file to .env for local runs. In GitHub Actions, set these as repo secrets instead
# (Settings -> Secrets and variables -> Actions) -- never commit a real .env file.

# Your Supabase project (same one card-claimer/yanks-tcg already uses).
# The anon/publishable key is safe to use here: the `cards` table has a
# public-read RLS policy, same as the storefront itself uses.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_STORAGE_BUCKET=ig-ad-assets

# Instagram Graph API (see SETUP.md for how to obtain these)
IG_ACCESS_TOKEN=your-long-lived-access-token
IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
